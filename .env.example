# Скопируйте в .env и поменяйте секреты: cp .env.example .env

# Домен, на котором висит приложение. Caddy сам возьмёт сертификат Let's Encrypt.
# Для локального запуска оставьте localhost — тогда HTTPS не выпускается.
CHITKOD_DOMAIN=localhost
# Почта для Let's Encrypt (на localhost не используется)
ACME_EMAIL=johnspolleto@gmail.com

# Секрет для подписи cookie. Обязательно поменяйте:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-generate-a-long-random-string

# Публичный адрес приложения — из него собираются персональные ссылки участников
PUBLIC_BASE_URL=http://localhost:8080

# База
POSTGRES_DB=chitkod
POSTGRES_USER=chitkod
POSTGRES_PASSWORD=change-me-too

# Порт, на котором Caddy слушает HTTP локально
HTTP_PORT=8080
HTTPS_PORT=8443
